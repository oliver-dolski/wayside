__pycache__/
*.pyc
.venv/
standards/.local/

# Plik literalow lokalnych warstwy tozsamosciowej bramki poufnosci (piata
# regula, identity-local-literal). Niesie literalne nazwy urzadzen i
# sygnatury z sieci pracodawcy, ktorych zaden wzorzec ksztaltu nie wyraza -
# jego trafienie do repozytorium bylby dokladnie tym wyciekiem, ktoremu ta
# warstwa ma zapobiegac. Ta sama koniecznosc architektoniczna, co przy
# lokalnym korpusie norm powyzej: nie wolno go wgrywac do sekretow
# repozytorium ani do konfiguracji CI.
.confidentiality-identity.local

# Stan runtime narzedzi pomocniczych autora, zwiazany z maszyna i sesja,
# nie z projektem. Odtwarzany przy kazdym uruchomieniu, w historii
# generowalby wylacznie konflikty miedzy maszynami.

# Katalog wyjsciowy domyslnego uruchomienia `wayside analyze`.
wayside-out/

# Zbior zewnetrzny (4SICS, REPORT-05) pobierany przez
# scripts/fetch_4sics_sample.py - wazy rzad setek megabajtow, do
# repozytorium wchodzi skrypt pobierajacy i wygenerowany raport, nigdy sam
# plik zrzutu (rekord decyzji `0005`).
datasets/

# Prywatne artefakty planowania autora (notatki, mapa prac, zapisy przegladow).
# Nie sa czescia dostarczanego narzedzia i nie maja wartosci dla nikogo poza
# autorem, wiec zostaja na jego maszynie zamiast puchnac publiczne repozytorium.
.planning/

# Katalogi stanu lokalnych narzedzi autora: zwiazane z maszyna i sesja,
# odtwarzane przy kazdym uruchomieniu, w historii generowalyby wylacznie
# konflikty miedzy maszynami.
.claude/
.gsd/
