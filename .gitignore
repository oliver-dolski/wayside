__pycache__/
*.pyc
.venv/
standards/.local/

# Local literal file of the identity layer of the confidentiality gate
# (fifth rule, identity-local-literal). It carries literal device names and
# signatures from the employer's network, which no shape pattern expresses -
# it landing in the repository would be exactly the leak this layer is meant
# to prevent. The same architectural necessity as the local corpus of
# standards above: it must never be uploaded to the repository secrets nor
# to the CI configuration.
.confidentiality-identity.local

# Runtime state of the author's helper tooling, tied to a machine and a
# session rather than to the project. Rebuilt on every run, in the history
# it would generate nothing but conflicts between machines.

# Output directory of a default `wayside analyze` run.
wayside-out/

# External capture set (4SICS, REPORT-05) downloaded by
# scripts/fetch_4sics_sample.py - it weighs hundreds of megabytes; what
# enters the repository is the download script and the generated report,
# never the capture file itself (decision record `0005`).
datasets/

# The author's private planning artifacts (notes, work map, review records).
# They are not part of the delivered tool and hold no value for anybody but
# the author, so they stay on his machine instead of swelling the public
# repository.
.planning/

# State directories of the author's local tooling: tied to a machine and a
# session, rebuilt on every run, in the history they would generate nothing
# but conflicts between machines.
.claude/
.gsd/
